      "applies_to": {
        "drugs": [
          "metformin"
        ]
      },
      "fact": "egfr",
      "requires_fact": true,
      "bands": [
        {
          "id": "METFORMIN_EGFR_LT30",
          "below": 30,
          "category": "contraindicated_drug",
          "severity": "severe"
        },
        {
          "id": "METFORMIN_EGFR_30_44_DOSE",
          "below": 45,
          "daily_mg_above": 1000,
          "category": "dose_error",
          "severity": "moderate"
        }
      ],
      "source": {
        "guideline": "Metformin prescribing information (contraindicated when eGFR < 30); KDIGO 2022 Diabetes in CKD; KDIGO 2022 Diabetes in CKD (reduce dose when eGFR 30-44; max 1000 mg/day)",
        "note": "metformin and kidney function"
      },
      "clinical_signoff": {
        "status": "not_reviewed",
        "by": null,
        "date": null
      }
    },
