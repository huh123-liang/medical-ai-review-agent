# Set locally through Configure-DeepSeek.cmd. Never paste credentials into chat.
DEEPSEEK_API_KEY=
JURY_MODEL=deepseek-flash
# Conservative CNY ceilings, NOT a quote of CNY provider billing.
# Official peak USD prices checked 2026-10-24; USD/CNY planning ceiling 8 + 25% margin.
JURY_INPUT_CNY_PER_MILLION=3.0
JURY_OUTPUT_CNY_PER_MILLION=12.0
JURY_PRICING_VALID_UNTIL=2026-10-31
JURY_BUDGET_CNY=30
JURY_MAX_OUTPUT_TOKENS=1200
JURY_TIMEOUT_SECONDS=90
JURY_MAX_ATTEMPTS=1
# Ordinary cases retain identical v2 inputs; source-backed safety alerts get v4 checks.
# Global v3/v4 remain experimental, not clinically validated.
JURY_JUDGE_PROFILE=scoped-review-v1
# Ambiguous exact citations retain all positions and require human review.
JURY_EVIDENCE_POLICY=anchored-v2
